+// M03: Per-Person, page-memory capabilities. The list of missing PersonIDs is
+// metadata only; no private values, code or token is returned in a denial.
+function oneTreeTokens(headers = {}) {
+  let tokens = {};
+  const encoded = headers['x-ft-page-token'];
+  if (typeof encoded === 'string' && encoded.length <= 12000) {
+    try {
+      const parsed = JSON.parse(encoded);
+      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) tokens = parsed;
+    } catch (_) { /* invalid capability data grants nothing */ }
+  }
+  return tokens;
+}
