+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const Module = require('node:module');
+const originalLoad = Module._load;
+Module._load = function (id, parent, isMain) {
+    if (id === './stage6Environment' && parent?.filename.endsWith('clientIp.js')) {
+        return { current: { mode: 'staging', publicOrigin: 'https://wapps-stage6-test.onrender.com' } };
+    }
+    return originalLoad.apply(this, arguments);
+};
+let functions;
+try {
+    functions = require('../services/passwordResetClientIp');
+} finally {
+    Module._load = originalLoad;
+}
+const { singleIP, trustedCfEnabled, clientIpForReset } = functions;
+const flags = { WA_TRUST_RENDER_CF_IP: '1' };
+const req = (cf, peer = '10.20.30.40') => ({
+    socket: { remoteAddress: peer },
+    rawHeaders: ['X-Forwarded-For', '198.51.100.77',
+        ...(cf === undefined ? [] : ['CF-Connecting-IP', cf])]
+});
+
+test('only proper unadorned IP literals pass; equivalent spellings are canonical', () => {
+    for (const val of ['192.0.2.4', '2001:db8::1', '::ffff:192.0.2.4']) assert(singleIP(val));
+    for (const val of ['', ' 192.0.2.4', '192.0.2.4, 1.2.3.4', '[2001:db8::1]',
+        'not-an-ip', '192.0.2.4:8080', 'fe80::1%eth0']) assert.equal(singleIP(val), null);
+    assert.equal(singleIP('2001:0DB8:0:0:0:0:0:1'), '2001:db8::1');
+    assert.equal(singleIP('::FFFF:C000:0204'), '192.0.2.4');
+});
+
+test('disabled by default, never uses forwarded info or shared peer', () => {
+    assert.equal(trustedCfEnabled({}), false);
+    assert.equal(clientIpForReset(req('203.0.113.5'), {}), null);
+});
+
+test('explicit staging opt-in can select a well formed CF address', () => {
+    assert.equal(trustedCfEnabled(flags), true);
+    assert.equal(clientIpForReset(req('203.0.113.5'), flags), '203.0.113.5');
+});
+
+test('malformed or missing CF header has no verified identity', () => {
+    for (const h of [undefined, 'garbage', '203.0.113.5, 198.51.100.77', ' 203.0.113.5']) {
+        assert.equal(clientIpForReset(req(h), flags), null);
+    }
+});
+
+test('spoofed XFF is ignored by resolver', () => {
+    assert.equal(clientIpForReset(req('203.0.113.5'), flags), '203.0.113.5');
+});
+
+test('invalid CF never falls back to shared proxy or XFF; duplicate CF is rejected', () => {
+    assert.equal(clientIpForReset(req('bad', '::ffff:10.0.0.7'), flags), null);
+    const duplicate = req('203.0.113.5');
+    duplicate.rawHeaders.push('cf-connecting-ip', '203.0.113.5');
+    assert.equal(clientIpForReset(duplicate, flags), null);
 });
